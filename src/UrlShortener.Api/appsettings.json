{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "UrlShortener": {
    "ShortCodeLength": 7,
    "MaxCollisionRetries": 5,
    "MaxUrlLength": 2048,
    "RedirectStatusCode": 302
  },
  "Cache": {
    "TtlHours": 24,
    "NegativeTtlSeconds": 60,
    "ConnectTimeoutMs": 1000,
    "OperationTimeoutMs": 500
  }
}
